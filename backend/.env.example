# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# --- LLM (Groq via LangChain) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
# Groq's free/on_demand tier caps each request (prompt + completion) at
# ~8000 tokens total. These defaults leave headroom under that cap.
LLM_MAX_TOKENS=3500
LLM_TOOL_LOOP_MAX_TOKENS=700

# --- MongoDB ---
# Default below matches a local instance (e.g. one you're browsing with
# MongoDB Compass). Swap for an Atlas connection string if you deploy.
MONGODB_URI=
MONGODB_DB_NAME=trip_planner

# --- Live provider APIs (all free tier -- see README for signup links) ---
# Flights + hotels: Travelpayouts (Aviasales/Hotellook cached price data)
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Restaurants + attractions: Geoapify Places API (free, no card)
GEOAPIFY_API_KEY=
# Weather: OpenWeatherMap (free)
OPENWEATHER_API_KEY=
# Maps/distance: OpenRouteService (free, no card). Optional alternative below.
OPENROUTESERVICE_API_KEY=
GOOGLE_MAPS_API_KEY=

REQUEST_TIMEOUT_SECONDS=12
